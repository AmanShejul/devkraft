# Supabase browser-safe project credentials. Required for production persistence and authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Retained for compatibility with teacher/demo data paths. Student login is intentionally demo-only.
STUDENT_DEMO_MODE=false
TEACHER_DEMO_MODE=false

# Server-only integrations planned for the next setup step. Never use NEXT_PUBLIC_ here.
GEMINI_API_KEY=
# Local teacher question generation. The URL is resolved by the Next.js server:
# use http://localhost:11434 only when Next.js and Ollama run on the same machine.
# For Docker, use http://host.docker.internal:11434 or the Ollama service name.
# For Vercel, replace this loopback URL with a reachable secured HTTPS Ollama endpoint;
# Vercel cannot connect to Ollama running on your development computer.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_MS=90000
OLLAMA_MAX_OUTPUT_TOKENS=8192
# Server-only Supabase key used for authoritative quiz grading. Never expose it as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_EXECUTION_ENABLED=false
# Alternative server-side execution provider. Set JUDGE0_API_URL to select Judge0
# instead of JDoodle; add JUDGE0_API_KEY when your Judge0 instance requires it.
JUDGE0_API_URL=
JUDGE0_API_KEY=
