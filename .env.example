# Supabase browser-safe project credentials (optional for local development)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only integrations planned for the next setup step. Never use NEXT_PUBLIC_ here.
GEMINI_API_KEY=
# Optional local question-generation fallback; start Ollama and pull this model first.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_MS=90000
# Server-only Supabase key used for authoritative quiz grading. Never expose it as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_EXECUTION_ENABLED=false
# Optional Judge0 endpoint/key only after the deployment has been verified.
JUDGE0_API_URL=
JUDGE0_API_KEY=
